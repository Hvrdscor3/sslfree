{
  "name": "navegador-ligero",
  "version": "1.0.0",
  "private": true,
  "description": "Navegador súper ligero para Fire TV (Vega OS) con bloqueo de pop-ups y anuncios y controles de vídeo con el mando.",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:release": "react-native build-vega --build-type Release",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "test:browser": "node tests/injected.browser.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@amazon-devices/react-native-kepler": "~4.0.2",
    "@amazon-devices/webview": "~4.0.5",
    "react": "19.2.0",
    "react-native": "0.83.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@types/react": "^19.2.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "kepler": {
    "projectType": "application",
    "appName": "sslfree",
    "targets": ["tv"]
  },
  "overrides": {
    "react": "19.2.0",
    "react-native": "0.83.0"
  }
}
